# Fistbump MM bot
# Keys on nodes: FBD_WALLET + BTC_RPC_WALLET
# ─────────────────────────────────────────────
HOST=127.0.0.1
PORT=8787
DATA_DIR=./data
CORS_ORIGINS=https://swap.fistbump.org

# Set to 1 ONLY when a reverse proxy you run (Caddy/Apache) sits in front.
# Trusting X-Forwarded-For from anyone lets a caller pick their rate-limit bucket.
TRUST_PROXY=0
# Per-IP token buckets. Writes hit bitcoind, fbd and disk, so they cost more.
RATE_LIMIT_READ_BURST=60
RATE_LIMIT_READ_PER_SEC=5
RATE_LIMIT_WRITE_BURST=10
RATE_LIMIT_WRITE_PER_SEC=1

PUBLIC_URL=https://mm.example.com
MAKER_NAME=my-mm
REGISTRY_URL=https://swap.fistbump.org/api
ANNOUNCE=1
# Proves you control PUBLIC_URL. Generate once: openssl rand -hex 16
# The bot publishes sha256(this) at /health; the registry checks the two agree,
# so nobody who merely reads your /health can claim your URL. Without it the
# bot runs fine but will not appear in the UI directory.
ANNOUNCE_TOKEN=

# Pricing — peg FBC to USD, paid in BTC
# 1 FBC = $0.01 of BTC at current BTC/USD (default)
FBC_USD_PRICE=0.01
BTC_USD_SOURCE=coinbase
# BTC_USD_SOURCE=kraken
# BTC_USD_SOURCE=fixed
# BTC_USD=100000
SPREAD_BPS=50
MAX_FBC=1000

# Timelocks (SPEC §4.2). BTC_REFUND_HOURS is the TAKER's refund window and it
# MUST exceed FBC_REFUND_HOURS — yours — by at least MIN_DELTA_HOURS. They fund
# first and hold the preimage, so their refund has to open last. Reversing
# these hands your whole FBC inventory to the first taker who simply waits;
# the bot refuses to start if they are the wrong way round.
BTC_REFUND_HOURS=48
FBC_REFUND_HOURS=24
MIN_DELTA_HOURS=12
# PRICE_CACHE_MS=60000
# Or disable peg and set static mid:
# FBC_USD_PRICE=0
# MID_FBC_PER_BTC=42000

# FBC — fbd node + wallet
FBD_RPC_URL=http://127.0.0.1:32869
FBD_RPC_COOKIE=/root/.fbd/.cookie
FBD_WALLET=mm

# BTC — Bitcoin Core (required; no explorer fallback)
BTC_RPC_URL=http://127.0.0.1:8332
BTC_RPC_USER=
BTC_RPC_PASSWORD=
BTC_RPC_WALLET=mm
